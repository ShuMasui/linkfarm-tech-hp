---
// 写真プレート。写真は台紙に貼った印画紙として扱い、文字を重ねない。
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** キャプション左（撮影地など） */
  caption?: string;
  /** キャプション右（年など） */
  captionRight?: string;
  /** チェキ風の日付焼き込み */
  date?: string;
  /** 図版を切らずに収める（画面キャプチャなど） */
  fit?: boolean;
  class?: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
}

const {
  src, alt, caption, captionRight, date,
  fit = false, class: className = '', width = 1200, height = 800, loading = 'lazy',
} = Astro.props;
---

<figure class:list={['plate', fit && 'plate--fit', className]}>
  <div class="plate__frame">
    <Image src={src} alt={alt} width={width} height={height} loading={loading} />
    {date && <span class="plate__date" aria-hidden="true">{date}</span>}
  </div>
  {(caption || captionRight) && (
    <figcaption class="plate__cap">
      <span>{caption}</span>
      {captionRight && <span>{captionRight}</span>}
    </figcaption>
  )}
</figure>
