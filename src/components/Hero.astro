---
---
<section class="relative min-h-screen flex items-center justify-center overflow-hidden aurora-bg animate-aurora py-20">
  <!-- 背景を浮遊する色相環グラデーションの円 -->
  <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-gradient-to-tr from-brand-secondary via-brand-primary to-brand-accent opacity-20 blur-3xl animate-spin-slow"></div>
  <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full bg-gradient-to-br from-brand-accent via-pink-400 to-indigo-400 opacity-25 blur-3xl animate-spin-slow" style="animation-direction: reverse;"></div>

  <div class="container mx-auto px-6 relative z-10 text-center">
    <!-- タグ -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-panel text-sm font-semibold tracking-wider text-brand-primary mb-6 animate-fade-in-up">
      <span class="w-2 h-2 rounded-full bg-brand-primary animate-ping"></span>
      Activity Report / Ver 1.0
    </div>

    <!-- メインタイトル -->
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tight mb-6 text-transparent bg-clip-text bg-gradient-to-r from-brand-primary via-brand-accent to-brand-secondary">
      LinkFarm Tech.
    </h1>

    <!-- サブタイトル -->
    <p class="text-2xl md:text-3xl font-extrabold text-wheat-dark mb-4 max-w-3xl mx-auto leading-relaxed">
      農業 <span class="text-brand-primary">×</span> テックで創る体験型学習
    </p>

    <!-- プロジェクト詳細説明 -->
    <p class="text-sm md:text-base font-semibold text-wheat-dark/70 mb-12 max-w-2xl mx-auto leading-relaxed">
      若年層の獲得と耕作放棄地活用のための、新しい地域循環型プロジェクト。
    </p>

    <!-- キャッチコピー & ボタン -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
      <a href="#problem" class="px-8 py-4 bg-brand-primary text-white font-bold rounded-xl shadow-lg shadow-brand-primary/30 hover:bg-brand-primary/95 transition-all duration-300 transform hover:-translate-y-1">
        プロジェクトの課題を見る
      </a>
      <a href="#cycle" class="px-8 py-4 glass-panel text-wheat-dark font-bold rounded-xl hover:bg-white/40 transition-all duration-300 transform hover:-translate-y-1 border border-wheat/60">
        体験型学習の仕組み
      </a>
    </div>

    <!-- スクロール促進アニメーション -->
    <div class="mt-20 flex flex-col items-center gap-2 pointer-events-none mx-auto w-fit">
      <span class="text-xs font-semibold tracking-widest text-wheat-dark/60 uppercase">Scroll</span>
      <div class="w-6 h-10 border-2 border-wheat-dark/40 rounded-full p-1">
        <div class="w-1.5 h-3 bg-brand-primary rounded-full mx-auto animate-bounce" style="animation-duration: 1.5s;"></div>
      </div>
    </div>
  </div>
</section>
