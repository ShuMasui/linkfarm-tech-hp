---
import { Image } from 'astro:assets';
import logo from '../assets/linkfarm-logo-sumi.png';
import { FOOT_MENU, SITE_TITLE, CONTACT_EMAIL_MASKED, SUBSIDY } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="sheet">
    <div class="foot-grid">
      <div>
        <h2 class="brand brand--foot">
          <Image src={logo} alt={SITE_TITLE} width={411} height={75} loading="lazy" />
        </h2>
        <p>
          農業とデジタル技術を掛け合わせ、若年層の農業関心を高めるとともに、耕作放棄地の活性化を目指しています。
        </p>
      </div>

      <div>
        <h3>MENU</h3>
        <ul>
          {FOOT_MENU.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3>LOCATION &amp; CONTACT</h3>
        <p>
          活動拠点：奈良県内の提携農地（耕作放棄地）<br />
          お問い合わせ：{CONTACT_EMAIL_MASKED}
        </p>
        <div class="sns">
          <a href="#" aria-label="X">X</a>
          <a href="#" aria-label="Instagram">IG</a>
          <a href="#" aria-label="GitHub">GH</a>
        </div>
      </div>
    </div>

    <div class="copy">
      <span>&copy; {year} {SITE_TITLE} All rights reserved.</span>
      <span>{SUBSIDY}</span>
    </div>
  </div>
</footer>
