---
import { Image } from 'astro:assets';
import logo from '../assets/linkfarm-logo-sumi.png';
import { NAV, CONTACT_NAV, SITE_TITLE, type NavKey } from '../consts';

interface Props {
  /** 現在地。事業詳細ページでは親の 'services' を渡す */
  current?: NavKey;
}
const { current } = Astro.props;
---

<header class="site-header">
  <div class="sheet site-header__in">
    <a class="brand" href="/">
      <Image src={logo} alt={SITE_TITLE} width={411} height={75} loading="eager" />
    </a>

    <nav class="nav">
      {NAV.map((item) => (
        <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a
        class="btn btn--fill btn--sm"
        href={CONTACT_NAV.href}
        aria-current={current === 'contact' ? 'page' : undefined}
      >
        {CONTACT_NAV.label}
      </a>
    </nav>

    <button class="menu-btn" id="menu-btn" aria-label="メニューを開く" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-open="false">
    <div class="sheet">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={CONTACT_NAV.href}>{CONTACT_NAV.label}</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const open = menu?.dataset.open === 'true';
    if (menu) menu.dataset.open = String(!open);
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', !open ? 'メニューを閉じる' : 'メニューを開く');
  });
</script>
