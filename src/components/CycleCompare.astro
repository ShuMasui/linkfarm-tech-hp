---
---
<section id="cycle" class="py-24 bg-wheat-light relative overflow-hidden">
  <!-- 背景のボケた円 -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-gradient-to-tr from-brand-secondary/5 via-brand-primary/5 to-brand-accent/5 blur-3xl"></div>

  <div class="container mx-auto px-6 relative z-10">
    <!-- セクションタイトル -->
    <div class="text-center max-w-3xl mx-auto mb-16 scroll-reveal">
      <span class="text-brand-secondary font-bold text-sm tracking-widest uppercase">The Solution</span>
      <h2 class="text-3xl md:text-5xl font-extrabold text-wheat-dark mt-2 mb-6">
        農作物の生まれから終わりまで全てを知る<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-primary to-brand-secondary">「体験型学習」の仕組み</span>
      </h2>
      <div class="w-20 h-1 bg-gradient-to-r from-brand-secondary to-brand-primary mx-auto rounded-full"></div>
    </div>

    <!-- サイクル対比のコンテナ -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
      
      <!-- 従来のサイクル -->
      <div class="bg-white/60 border border-stone-200/60 rounded-3xl p-8 shadow-sm flex flex-col justify-between scroll-reveal">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-stone-100 text-stone-600 text-xs font-bold tracking-wider mb-6">
            Conventional / 従来のサイクル
          </div>
          <h3 class="text-2xl font-bold text-stone-700 mb-2">生産と消費の分断</h3>
          <p class="text-stone-500 text-sm mb-10 leading-relaxed">
            食べる人は、自分が食べる野菜が「誰に、どうやって育てられたか」を知ることができず、単なる「商品」として消費します。
          </p>
        </div>

        <!-- 従来サイクルのステップリスト -->
        <div class="space-y-8 relative pl-3 before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-[2px] before:bg-stone-200">
          <!-- ステップ1 -->
          <div class="relative pl-10 flex flex-col justify-center min-h-[40px] group">
            <div class="absolute left-0 top-0.5 w-6 h-6 rounded-full bg-white border-2 border-stone-300 flex items-center justify-center text-xs font-bold text-stone-400 group-hover:border-stone-500 transition-colors">1</div>
            <div>
              <h4 class="font-bold text-stone-700 text-base">田植え・苗植え</h4>
              <p class="text-xs text-stone-500 mt-0.5">農家さんだけで行う栽培の開始</p>
            </div>
          </div>
          <!-- ステップ2 -->
          <div class="relative pl-10 flex flex-col justify-center min-h-[40px] group">
            <div class="absolute left-0 top-0.5 w-6 h-6 rounded-full bg-white border-2 border-stone-300 flex items-center justify-center text-xs font-bold text-stone-400 group-hover:border-stone-500 transition-colors">2</div>
            <div>
              <h4 class="font-bold text-stone-700 text-base">収穫</h4>
              <p class="text-xs text-stone-500 mt-0.5">機械化または人手不足の中での回収</p>
            </div>
          </div>
          <!-- ステップ3 -->
          <div class="relative pl-10 flex flex-col justify-center min-h-[40px] group">
            <div class="absolute left-0 top-0.5 w-6 h-6 rounded-full bg-white border-2 border-stone-300 flex items-center justify-center text-xs font-bold text-stone-400 group-hover:border-stone-500 transition-colors">3</div>
            <div>
              <h4 class="font-bold text-stone-700 text-base">小売店</h4>
              <p class="text-xs text-stone-500 mt-0.5">スーパーなどに並ぶ無機質な野菜</p>
            </div>
          </div>
          <!-- ステップ4 -->
          <div class="relative pl-10 flex flex-col justify-center min-h-[40px] group">
            <div class="absolute left-0 top-0.5 w-6 h-6 rounded-full bg-white border-2 border-stone-300 flex items-center justify-center text-xs font-bold text-stone-400 group-hover:border-stone-500 transition-colors">4</div>
            <div>
              <h4 class="font-bold text-stone-700 text-base">消費</h4>
              <p class="text-xs text-stone-500 mt-0.5">食卓での消費（生産背景は一切見えない）</p>
            </div>
          </div>
        </div>
      </div>

      <!-- LinkFarmのサイクル -->
      <div class="relative bg-gradient-to-b from-white to-wheat/10 border-2 border-brand-secondary/30 rounded-3xl p-8 shadow-md flex flex-col justify-between overflow-hidden scroll-reveal">
        <!-- バッジ -->
        <div class="absolute top-0 right-0 bg-brand-secondary text-white font-bold text-xs uppercase tracking-widest px-4 py-1.5 rounded-bl-2xl">
          Active Learn
        </div>

        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-secondary/10 text-brand-secondary text-xs font-bold tracking-wider mb-6">
            LinkFarm Cycle / テックで繋がる新たな関係
          </div>
          <h3 class="text-2xl font-bold text-wheat-dark mb-2">プロセスそのものを楽しむ</h3>
          <p class="text-wheat-dark/70 text-sm mb-10 leading-relaxed">
            植えるところから、テックの力を借りた成長の追体験、自分の手での収穫、保持する愛着、そして最後にみんなで食べる喜びまで、一連の物語を体験します。
          </p>
        </div>

        <!-- LinkFarmサイクルのステップリスト -->
        <div class="space-y-8 relative pl-3 before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-[2px] before:bg-brand-secondary/30">
          <!-- ステップ1 -->
          <div class="relative pl-10 flex flex-col justify-center min-h-[40px] group">
            <div class="absolute left-0 top-0.5 w-6 h-6 rounded-full bg-brand-secondary text-white flex items-center justify-center text-xs font-bold shadow-sm">1</div>
            <div>
              <h4 class="font-bold text-wheat-dark text-base flex items-center gap-2">
                田植え・苗植え
                <span class="text-[10px] bg-brand-primary/10 text-brand-primary px-2 py-0.5 rounded-full font-medium">現地体験</span>
              </h4>
              <p class="text-xs text-wheat-dark/60 mt-0.5">自分の手で土を触り、苗を植える感動の第一歩</p>
            </div>
          </div>
          <!-- ステップ2 -->
          <div class="relative pl-10 flex flex-col justify-center min-h-[40px] group">
            <div class="absolute left-0 top-0.5 w-6 h-6 rounded-full bg-brand-primary text-white flex items-center justify-center text-xs font-bold shadow-sm animate-pulse">2</div>
            <div>
              <h4 class="font-bold text-wheat-dark text-base flex items-center gap-2">
                成長のフィードバック
                <span class="text-[10px] bg-brand-accent/10 text-brand-accent px-2 py-0.5 rounded-full font-medium">Tech機能</span>
              </h4>
              <p class="text-xs text-wheat-dark/60 mt-0.5">オンラインで成長日記、画像配信、NFTなどで苗の「今」を知る</p>
            </div>
          </div>
          <!-- ステップ3 -->
          <div class="relative pl-10 flex flex-col justify-center min-h-[40px] group">
            <div class="absolute left-0 top-0.5 w-6 h-6 rounded-full bg-brand-secondary text-white flex items-center justify-center text-xs font-bold shadow-sm">3</div>
            <div>
              <h4 class="font-bold text-wheat-dark text-base flex items-center gap-2">
                自ら収穫
                <span class="text-[10px] bg-brand-primary/10 text-brand-primary px-2 py-0.5 rounded-full font-medium">現地体験</span>
              </h4>
              <p class="text-xs text-wheat-dark/60 mt-0.5">大きくなった作物を、再び現地に足を運んで自分の手で収穫</p>
            </div>
          </div>
          <!-- ステップ4 -->
          <div class="relative pl-10 flex flex-col justify-center min-h-[40px] group">
            <div class="absolute left-0 top-0.5 w-6 h-6 rounded-full bg-brand-accent text-white flex items-center justify-center text-xs font-bold shadow-sm">4</div>
            <div>
              <h4 class="font-bold text-wheat-dark text-base flex items-center gap-2">
                食事で消費
                <span class="text-[10px] bg-brand-accent/10 text-brand-accent px-2 py-0.5 rounded-full font-medium">食事イベント</span>
              </h4>
              <p class="text-xs text-wheat-dark/60 mt-1">収穫したての野菜で料理を作り、仲間と共に味わう最高の瞬間</p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- アプローチ手法の補足カード -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-16 scroll-reveal">
      <div class="bg-white border border-wheat/20 rounded-2xl p-6 flex items-start gap-4 hover:shadow-sm transition-shadow">
        <div class="w-12 h-12 rounded-xl bg-brand-primary/10 flex items-center justify-center text-brand-primary font-bold shrink-0">人</div>
        <div>
          <h4 class="font-bold text-wheat-dark mb-1">農業人口減少の解決に向けて</h4>
          <p class="text-sm text-wheat-dark/70 leading-relaxed">
            若年層に「楽しさ」や「関心」を届けることで、持続可能で自然な就農希望者の増加サイクルを目指します。
          </p>
        </div>
      </div>
      <div class="bg-white border border-wheat/20 rounded-2xl p-6 flex items-start gap-4 hover:shadow-sm transition-shadow">
        <div class="w-12 h-12 rounded-xl bg-brand-secondary/10 flex items-center justify-center text-brand-secondary font-bold shrink-0">地</div>
        <div>
          <h4 class="font-bold text-wheat-dark mb-1">耕作放棄地の利活用</h4>
          <p class="text-sm text-wheat-dark/70 leading-relaxed">
            使われていない農地を「体験型イベント」のフィールドとして再定義し、新しい需要と価値を創出します。
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
