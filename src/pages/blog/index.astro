---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// BreadcrumbList JSON-LD 構造化データ
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "ホーム",
      "item": Astro.site ? Astro.site.toString() : Astro.url.origin
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "活動日誌",
      "item": Astro.url.href
    }
  ]
};
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
  <head>
    <BaseHead title={`活動日誌 (Blog) - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <!-- JSON-LD 構造化データ -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <body class="bg-wheat-light text-wheat-dark font-sans antialiased overflow-x-hidden">
    <!-- ヘッダー -->
    <Header />

    <main class="py-16 md:py-24">
      <div class="container mx-auto px-6 max-w-6xl">
        <!-- ページタイトル -->
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-brand-secondary font-bold text-sm tracking-widest uppercase">Blog</span>
          <h1 class="text-3xl md:text-5xl font-extrabold text-wheat-dark mt-2 mb-6">
            活動日誌
          </h1>
          <p class="text-wheat-dark/70">
            体験型学習プロジェクト LinkFarm Tech. の日々の活動、農作物の成長、メンバーの思いなどを綴っています。
          </p>
          <div class="w-20 h-1 bg-gradient-to-r from-brand-secondary to-brand-primary mx-auto rounded-full mt-6"></div>
        </div>

        <!-- 記事一覧グリッド -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post, index) => (
            <article class={`bg-white border border-stone-200/50 rounded-3xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1 flex flex-col justify-between ${index === 0 ? 'md:col-span-2 lg:col-span-3 lg:flex-row' : ''}`}>
              
              <!-- サムネイル画像 -->
              <div class={`relative overflow-hidden bg-stone-100 ${index === 0 ? 'lg:w-3/5 aspect-[16/10] lg:aspect-auto' : 'aspect-[16/10]'}`}>
                {post.data.heroImage ? (
                  <Image 
                    src={post.data.heroImage} 
                    alt={post.data.title} 
                    width={720}
                    height={450}
                    class="w-full h-full object-cover" 
                  />
                ) : (
                  /* 代替グラデーション */
                  <div class="w-full h-full bg-gradient-to-tr from-brand-primary/10 via-brand-accent/10 to-brand-secondary/10 flex items-center justify-center font-bold text-brand-primary/40 text-sm min-h-[200px]">
                    No Image
                  </div>
                )}
              </div>

              <!-- コンテンツエリア -->
              <div class={`p-6 md:p-8 flex flex-col justify-between ${index === 0 ? 'lg:w-2/5' : 'flex-1'}`}>
                <div>
                  <span class="text-xs text-stone-400 font-semibold uppercase tracking-wider block mb-2">
                    <FormattedDate date={post.data.pubDate} />
                  </span>
                  
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mb-3">
                      {post.data.tags.map((tag) => (
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-brand-primary/5 text-brand-primary border border-brand-primary/10">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                  
                  <h2 class={`font-bold text-wheat-dark hover:text-brand-primary transition-colors mb-4 line-clamp-2 ${index === 0 ? 'text-2xl md:text-3xl' : 'text-xl'}`}>
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h2>
                  
                  <p class="text-sm text-stone-500 leading-relaxed mb-6 line-clamp-3">
                    {post.data.description}
                  </p>
                </div>

                <div class="pt-4 border-t border-stone-100/50">
                  <a href={`/blog/${post.id}/`} class="text-sm font-bold text-brand-primary hover:text-brand-primary/80 inline-flex items-center gap-1">
                    この記事を読む
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>

            </article>
          ))}
        </div>
      </div>
    </main>

    <!-- フッター -->
    <Footer />
  </body>
</html>
