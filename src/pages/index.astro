---
import Page from '../layouts/Page.astro';
import Plate from '../components/Plate.astro';
import Hashira from '../components/Hashira.astro';
import { SITE_TITLE_FULL, SITE_DESCRIPTION, CONTACT_EMAIL } from '../consts';
import heroField from '../assets/hero/hero-02.jpg';

// トップは表紙と目次に徹する。想定読者が5種類いるため、
// 誰が来ても2クリック以内に目的へ降りられることを唯一の仕事とする。
// → docs/01-overview.md 第4節
const TOC = [
  {
    no: '01', en: 'SERVICES', ja: '事業内容', href: '/services/',
    desc: '現地の体験を設計する仕事、提携農家様と学生をつなぐ仕事、そして活動を届けるWeb制作。',
  },
  {
    no: '02', en: 'ORGANIZATION', ja: '団体概要', href: '/organization/',
    desc: '奈良の学生二人で動かしている団体です。設立、代表者、活動拠点。',
  },
  {
    no: '03', en: 'MEMBERS', ja: 'メンバー', href: '/members/',
    desc: 'テクノロジーと農業を、一人ずつ持ち寄っています。',
  },
  {
    no: '04', en: 'JOURNAL', ja: '活動日誌', href: '/blog/',
    desc: '現場で起きたことと、作物の成長記録。',
  },
  {
    no: '05', en: 'CONTACT', ja: 'お問い合わせ', href: '/contact/',
    desc: '参加・協賛、農地の連携、制作のご相談。',
  },
];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'LinkFarm Tech.',
  url: 'https://linkfarm-tech.com',
  logo: 'https://linkfarm-tech.com/favicon.svg',
  description: SITE_DESCRIPTION,
  email: CONTACT_EMAIL,
  foundingDate: '2026-05-01',
  address: {
    '@type': 'PostalAddress',
    addressRegion: '奈良県',
    addressLocality: '奈良市',
    addressCountry: 'JP',
  },
  keywords: [
    'HP', 'メインページ', 'なら', '奈良', '学生', '補助金', '情報化システム',
    '農業', 'インバウンド', '体験型アクティビティ', '楽しい', 'シビックテック',
    '奈良市', '産学連携', 'LinkFarm Tech.',
    '宇陀市', 
  ],
  founder: [
    {
      '@type': 'Person',
      name: 'Shu MASUI',
      jobTitle: '学生代表 / Co-Founder & Technology Lead',
      description:
        'スマート農業技術、NFT、配信システム、およびスタンプ生成など、プロジェクトのテック基盤の設計・開発全般と全体の進行管理を担当。',
      affiliation: { '@type': 'EducationalOrganization', name: '奈良工業高等専門学校' },
    },
    {
      '@type': 'Person',
      name: 'Ryosuke TANIGAWA',
      jobTitle: '専門技術代表 / Co-Founder & Agriculture/Culinary Lead',
      description:
        '現地での栽培計画、作物の状態管理、および収穫後の食事イベントのメニュー考案・調理監修を担当。',
      affiliation: { '@type': 'EducationalOrganization', name: '天理大学' },
    },
  ],
};
---

<Page
  title={SITE_TITLE_FULL}
  description={SITE_DESCRIPTION}
  tategaki="農業 × テクノロジー ／ 奈良"
  current="home"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} slot="head" />

  <section class="cover">
    <div class="sheet">
      <p class="cover__eyebrow">LINKFARM TECH. — AGRICULTURE × TECHNOLOGY</p>

      <h1 class="display">
        農業に、<br /><span class="ul">人が向かう理由</span>をつくる。
      </h1>

      <p class="lead">{SITE_DESCRIPTION}</p>
    </div>
  </section>

  <section class="section toc-section">
    <div class="sheet spread">
      <Hashira no="目次" en="CONTENTS" ja="このサイトについて" />

      <nav class="toc" aria-label="目次">
        {TOC.map((item) => (
          <a class="toc__row" href={item.href}>
            <span class="toc__no">§ {item.no}</span>
            <span class="toc__en">{item.en}</span>
            <span class="toc__ja">{item.ja}</span>
            <span class="toc__desc">{item.desc}</span>
            <span class="toc__ar" aria-hidden="true">→</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section gallery">
    <div class="sheet">
      {/* 写真が増えたらこの枠をカルーセルにする。高さと比率は据え置く。
          制約（自動再生しない・文字を重ねない・prefers-reduced-motion を尊重する・
          JS 無効でも1枚目が出る）は docs/02-design.md 第6節を参照 */}
      <Plate
        class="gallery__plate"
        src={heroField}
        alt="草を刈り整えた耕作地と、その先に広がる奈良の里山の集落"
        caption="活動フィールド — 宇陀市内の提携農地（耕作放棄地）"
        captionRight="2026"
        width={2400}
        height={1350}
        loading="eager"
      />
    </div>
  </section>

  <section class="section partners">
    <div class="sheet spread">
      <Hashira no="パートナー" en="PARTNERS" ja="協賛・提携" />

      <div>
        <p class="partners__note">Partners will be arrived</p>
      </div>
    </div>
  </section>
</Page>

<style>
  .cover { padding: clamp(72px, 12vw, 148px) 0 clamp(64px, 9vw, 120px); }
  .cover__eyebrow {
    font-size: .68rem;
    font-weight: 500;
    letter-spacing: .28em;
    color: var(--color-sumi-50);
    display: flex;
    align-items: center;
    gap: 1.1em;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .cover__eyebrow::before {
    content: "";
    width: clamp(28px, 4vw, 52px);
    height: 1px;
    background: var(--color-sumi);
    flex: none;
  }

  /* 目次 → 写真 → パートナー が連続するため、隣り合う節の上下パディングが
     足し合わさって写真の上下が 180px / 360px とちぐはぐになる。
     写真の節は自前の余白を持たず、前後の節の側で明示的に揃える */
  /* .contents という名前は Tailwind の display:contents ユーティリティと
     衝突して要素のボックスごと消えるので使えない */
  .toc-section { padding-bottom: clamp(48px, 6vw, 80px); }
  .gallery  { padding-block: 0; }
  .partners { padding-top: clamp(48px, 6vw, 80px); }

  /* パートナーはまだ無い。点線の罫で「これから入る場所」であることを示す。
     画面端の点線と同じ語彙 */
  .partners__note {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    letter-spacing: .04em;
    color: var(--color-sumi-50);
    margin: 0;
    padding: clamp(28px, 4vw, 44px) 0;
    border-top: 1px dotted var(--color-sumi-35);
    border-bottom: 1px dotted var(--color-sumi-35);
  }
</style>
