---
// 活動日誌の記事ページ。扉・写真プレート・本文（.prose）の三段で組む。
import type { CollectionEntry } from 'astro:content';
import Page from './Page.astro';
import PageHead from '../components/PageHead.astro';
import Plate from '../components/Plate.astro';
import ArrowLink from '../components/ArrowLink.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';
import { generateBlogPostSchema } from '../utils/schema';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;

// JSON-LD 構造化データ (BlogPosting & BreadcrumbList)
const schema = generateBlogPostSchema({
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  url: Astro.url.href,
  siteUrl: Astro.site ? Astro.site.toString() : undefined,
});
---

<Page
  title={`${title} — ${SITE_TITLE}`}
  description={description}
  tategaki="活動日誌 ／ LinkFarm Tech."
  current="journal"
  image={heroImage}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <PageHead no="04" en="JOURNAL" crumb={title} parent={{ label: '活動日誌', href: '/blog/' }}>
    <span slot="title">{title}</span>

    <p class="postmeta">
      <FormattedDate date={pubDate} />
      {updatedDate && (
        <span class="postmeta__upd">更新　<FormattedDate date={updatedDate} /></span>
      )}
    </p>

    {tags.length > 0 && (
      <div class="tags postmeta__tags">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    )}

    <p class="lead postmeta__lead">{description}</p>
  </PageHead>

  <section class="section postbody">
    <div class="sheet">
      {heroImage && (
        <Plate
          src={heroImage}
          alt={title}
          class="postplate"
          width={1200}
          height={750}
          loading="eager"
        />
      )}

      <div class="prose">
        <slot />
      </div>

      <div class="nextpage">
        <ArrowLink href="/blog/">活動日誌の一覧へ戻る</ArrowLink>
      </div>
    </div>
  </section>
</Page>

<style>
  /* 扉に添える日付と更新日。小さい字なので本文側の書体を使う
     （--mincho は存在しない変数だった） */
  .postmeta {
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--color-sumi-50);
    margin: 0 0 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.4em;
  }
  .postmeta__upd {
    color: var(--color-sumi-35);
  }
  .postmeta__tags {
    margin-bottom: 1.4rem;
  }
  .postmeta__lead {
    margin: 0;
  }
  /* 扉のリード文のすぐ下に写真を置くので、セクションの上パディングは要らない。
     .pagehead 側の下パディングだけで間を取る */
  .postbody {
    padding-top: 0;
  }

  /* .postplate の寸法は global.css にある。
     Plate は子コンポーネントなので、ここの scoped style は届かない */
</style>
